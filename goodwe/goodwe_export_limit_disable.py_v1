#!/bin/python3

import asyncio
import os
import sys
script_dir = os.path.dirname(os.path.abspath(__file__))
sys.path.append(os.path.join(script_dir, 'goodwe'))
import goodwe
import configparser

config = configparser.ConfigParser()
config.read(os.path.join(script_dir,'../conf/goodwe.conf'))

async def disable_grid_export_limit():
    ip_address = config['settings']['ip_address']
    inverter = await goodwe.connect(ip_address)

    # Set value to 0 (turn off)
    await inverter.write_setting('grid_export', 0)
    print("Grid Export Limit was turned off.")

asyncio.run(disable_grid_export_limit())

